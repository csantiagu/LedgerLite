{
  "name": "ledgerlite-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run deploy:api && npm run deploy:site",
    "migrate:local": "wrangler d1 migrations apply accounts-db --local",
    "migrate:remote": "wrangler d1 migrations apply accounts-db --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "deploy:api": "wrangler deploy",
    "deploy:site": "npm --prefix ../frontend run build && cd ../frontend && ../worker/node_modules/.bin/wrangler pages deploy --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "fflate": "^0.8.2",
    "hono": "^4.13.12",
    "pdf-lib": "^1.17.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
